import random

levels = {
    "1": ("Easy", 50, 10),
    "2": ("Medium", 100, 7),
    "3": ("Hard", 200, 5),
}

# Keep track of best scores for each level this session.
best = {"Easy": None, "Medium": None, "Hard": None}

def choose_level():
    print("\nChoose difficulty:")
    for key, (name, limit, tries) in levels.items():
        print(f"{key}. {name} (1-{limit}, {tries} tries)")

    choice = input("Enter 1, 2 or 3: ").strip()
    while choice not in levels:
        choice = input("Wrong choice, enter 1, 2 or 3: ").strip()

    return levels[choice]

# The function below calculates possible hints and randomizes which hint is to be provided to the user after each guess.

def give_hint(guess, number, proper_factors, is_prime, state):
    choice = random.choice([1, 2, 3])

    if choice == 2:
        if proper_factors:
            factor = proper_factors.pop(random.randrange(len(proper_factors)))
            print(f"Hint: {factor} is a factor of the secret number.")
            return
        elif is_prime and not state.get("prime_revealed", False):
            state["prime_revealed"] = True
            print("Hint: The secret number is a prime number!")
            return
        else:
            choice = random.choice([1, 3])

    if choice == 1:
        if guess < number:
            print("Hint: Your guess is too low.")
        else:
            print("Hint: Your guess is too high.")
    elif choice == 3:
        diff = abs(guess - number)
        low_bound = max(1, diff - random.randint(1, 5))
        high_bound = diff + random.randint(1, 5)
        print(f"Hint: The distance to the secret number is between {low_bound} and {high_bound}.")

# The function below displays various different prompts to the user based on whether the number is prime, composite or 1.

def show_number_facts(number, all_factors):
    if len(all_factors) == 2:
        print(f"Math Fact: {number} is prime (only divisible by 1 and itself).")
    elif number == 1:
        print("Math Fact: 1 is neither prime nor composite.")
    else:
        print(f"Math Fact: {number} is a composite number.")
        print(f"Factors: {all_factors}")

def play(level_name, limit, tries):
    number = random.randint(1, limit)

    all_factors = [i for i in range(1, number + 1) if number % i == 0]
    proper_factors = [f for f in all_factors if f != 1 and f != number]
    is_prime = len(all_factors) == 2
    hint_state = {"prime_revealed": False}

    count = 0
    print(f"\nGuess a number between 1 and {limit}. You have {tries} tries.")

    while count < tries:
        try:
            guess = int(input("Your guess: "))
        except ValueError:
            print("Numbers only, please!")
            continue

        count += 1

        if guess == number:
            print(f"Spot on! Got it in {count} tries.")
            show_number_facts(number, all_factors)

            if best[level_name] is None or count < best[level_name]:
                best[level_name] = count
                print(f"New session best for {level_name}!")
            return

        print(f"Tries left: {tries - count}")

        if count < tries:
            give_hint(guess, number, proper_factors, is_prime, hint_state)

    print(f"\nOut of tries! The number was {number}.")
    show_number_facts(number, all_factors)

def show_scores():
    print("\n--- Session High Scores ---")
    for level, score in best.items():
        score_text = str(score) if score else "no record yet"
        print(f"{level}: {score_text}")
    print("---------------------------")

def main():
    print("--- Number Guessing Game ---")
    while True:
        level_name, limit, tries = choose_level()
        play(level_name, limit, tries)
        show_scores()

        again = input("\nPlay again? (y/n): ").strip().lower()
        if again != 'y':
            print("Thanks for playing!")
            break

if __name__ == "__main__":
    main()
